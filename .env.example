# ── Database ──────────────────────────────────────────
DB_USER=anchor
DB_PASSWORD=change_me_strong_password
DB_HOST=db
DB_PORT=5432
DB_NAME=anchor
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Separate MLflow metadata DB to avoid Alembic/MLflow migration collisions
MLFLOW_DB_NAME=anchor_mlflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Broker ─────────────────────────────────────────────
BROKER_PROVIDER=ibkr
TRADING_DOMAIN=futures

# ── IBKR ───────────────────────────────────────────────
IBKR_HOST=ib_gateway
IBKR_PORT=4004
IBKR_CLIENT_ID=1
IBKR_PAPER_ACCOUNT_ID=DUXXXXXXX
IBKR_PAPER_USERNAME=paper_username_here
IBKR_ACCOUNT_ALIAS=paper
IBKR_EXCHANGE_FOREX=IDEALPRO
IBKR_EXCHANGE_CRYPTO=PAXOS
IBKR_MARKET_DATA_TYPE=3
FUTURES_V1_ENABLED=true
FUTURES_V1_PAPER_ONLY=true
FUTURES_V1_AUTO_EXECUTE=true
FUTURES_V1_MARKETS=MNQ,ZN,MGC,MCL
FUTURES_V1_CANDIDATE_MARKETS=MNQ,ZN,MGC,MCL
FUTURES_V1_TREND_LOOKBACK_DAYS=63
FUTURES_REBALANCE_FREQUENCY=weekly
FUTURES_SIGNAL_THRESHOLD=0.01
FUTURES_VOL_LOOKBACK_DAYS=20
FUTURES_TARGET_GROSS_EXPOSURE=2.50
FUTURES_MAX_MARGIN_USAGE_PCT=0.35
FUTURES_MAX_CONTRACTS_PER_MARKET=2
FUTURES_TRANSACTION_COST_BPS=1.0
FUTURES_ROLL_COST_BPS=2.0
FUTURES_MARGIN_WARN_USAGE_PCT=0.45
FUTURES_MARGIN_BLOCK_NEW_OPENS_PCT=0.55
FUTURES_MARGIN_FORCE_DERISK_USAGE_PCT=0.65
FUTURES_WEEKEND_GUARD_ENABLED=true
TWS_USERID=paper_username_here
TWS_PASSWORD=change_me
TWS_ACCEPT_INCOMING=accept
TRADING_MODE=paper
READ_ONLY_API=no
VNC_SERVER_PASSWORD=change_me_vnc
AUTO_RESTART_TIME=
RELOGIN_AFTER_2FA_TIMEOUT=no
TIME_ZONE=Etc/UTC

# ── AI (Intelligence layer) ────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Market Data ─────────────────────────────────────────
POLYGON_API_KEY=your_polygon_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── FRED (Macro data) ──────────────────────────────────
FRED_API_KEY=your_fred_api_key_here

# ── Telegram Alerts ────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── App ────────────────────────────────────────────────
APP_ENV=development   # development | production
SECRET_KEY=change_me_long_random_secret_key
LOG_LEVEL=INFO

# ── Grafana ────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password

# ── Risk Parameters (can be overridden here) ───────────
INSTRUMENTS=MNQ,ZN,MGC,MCL
MAX_RISK_PER_TRADE=0.01        # global default fallback
MAX_DAILY_LOSS=0.03            # 3% daily loss limit
DRAWDOWN_REDUCE_PCT=0.08       # 8% drawdown → halve position size
DRAWDOWN_HALT_PCT=0.15         # 15% drawdown → halt all trading
MIN_CONFLUENCE_SCORE=0.72
MIN_ML_CONFIDENCE=0.58
ENABLE_TREND_ENGINE=false
TREND_PAPER_ONLY=true
TREND_RISK_PCT=0.001           # 0.10%
ENABLE_MR_ENGINE=false
MR_PAPER_ONLY=false
MR_RISK_PCT=0.0015             # 0.15%
ENABLE_LCR_ENGINE=false
LCR_PAPER_ONLY=false
LCR_RISK_PCT=0.0035            # 0.35%
ENABLE_M15_ENGINE=false
M15_PAPER_ONLY=true
M15_RISK_PCT=0.0005            # 0.05%
EXPECTED_PILOT_INSTRUMENTS=MNQ,ZN,MGC,MCL
EXPECTED_PILOT_TREND_ENABLED=false
EXPECTED_PILOT_TREND_PAPER_ONLY=true
EXPECTED_PILOT_TREND_RISK_PCT=0.001
EXPECTED_PILOT_MR_ENABLED=false
EXPECTED_PILOT_MR_PAPER_ONLY=false
EXPECTED_PILOT_MR_RISK_PCT=0.0015
EXPECTED_PILOT_LCR_ENABLED=false
EXPECTED_PILOT_LCR_PAPER_ONLY=false
EXPECTED_PILOT_LCR_RISK_PCT=0.0035
EXPECTED_PILOT_M15_ENABLED=false
EXPECTED_PILOT_M15_PAPER_ONLY=true
EXPECTED_PILOT_M15_RISK_PCT=0.0005
