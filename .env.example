# ── Database ──────────────────────────────────────────
DB_USER=anchor
DB_PASSWORD=change_me_strong_password
DB_HOST=db
DB_PORT=5432
DB_NAME=anchor
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── OANDA ──────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice   # practice | live

# ── FRED (Macro data) ──────────────────────────────────
FRED_API_KEY=your_fred_api_key_here

# ── Telegram Alerts ────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── App ────────────────────────────────────────────────
APP_ENV=development   # development | production
SECRET_KEY=change_me_long_random_secret_key
LOG_LEVEL=INFO

# ── Grafana ────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password

# ── Risk Parameters (can be overridden here) ───────────
MAX_RISK_PER_TRADE=0.01        # 1% of account
MAX_DAILY_LOSS=0.03            # 3% daily loss limit
DRAWDOWN_REDUCE_PCT=0.08       # 8% drawdown → halve position size
DRAWDOWN_HALT_PCT=0.15         # 15% drawdown → halt all trading
MIN_CONFLUENCE_SCORE=0.65
MIN_ML_CONFIDENCE=0.58
